# dsh-tui is a Cordis plugin package for DeepSeek Harness. The runtime
# framework packages are declared as peer + dev dependencies (the profile /
# host plane provides the peers). `legacy-peer-deps` keeps pnpm from hard-failing
# when a package's own peer range (e.g. `dsh-system-prompt@>=0.1.1 <0.2.0-0`) is
# unsatisfiable by prerelease versions in the `0.1.1-rc.x` line — the same
# setting the community dsh-TUI ships with.
legacy-peer-deps=true
